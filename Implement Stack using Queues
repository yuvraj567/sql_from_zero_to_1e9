class MyStack {
public:
    queue<int> q1, q2;
    int peek;

    MyStack() {
        
    }
    
    void push(int x) {
        q1.push(x);
        peek = x;
    }
    
    int pop() {
        while(q1.size() != 1) {
            peek = q1.front();
            q1.pop();
            q2.push(peek);
        }
        int ans = q1.front();
        q1.pop();
        
        q1 = q2;
        while (!q2.empty()) {
            q2.pop();
        }

        return ans;
    }
    
    int top() {
        return peek;
    }
    
    bool empty() {
        return q1.empty();
    }
};

