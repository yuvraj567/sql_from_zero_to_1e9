class Solution {
public:
    int uniquePathsWithObstacles(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        int dp[n][m];
        memset(dp, 1e9, sizeof(dp));

        if (grid[0][0] != 1) dp[0][0] = 1;

        for (int i = 1; i < n; i++) {
            if (grid[i][0] != 1)
                dp[i][0] = max(dp[i - 1][0], grid[i][0]);
        }

        for (int i = 1; i < m; i++) {
            if (grid[0][i] != 1) dp[0][i] = max(dp[0][i - 1], grid[0][i]);
        }

        // for (int i = 0; i < n; i++) {
        //     for (int j = 0; j < m; j++) {
        //         cout << dp[i][j] << " ";
        //     }
        //     cout << endl;
        // }

        for (int i = 1; i <  n; i++) {
            for (int j = 1; j < m; j++) {
                if (grid[i][j] != 1) {
                    if (dp[i-1][j] != 1e9) {
                        dp[i][j] = dp[i-1][j];
                    }
                    if (dp[i][j-1] != 1e9) {
                        dp[i][j] += dp[i][j-1];
                    }
                }
            }
        }
        return dp[n-1][m-1];
    }
};
